# The MCP server reads SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY from the
# satellite's ../.env.local (already present, already gitignored). This file
# only carries the extra bits the server needs.

# Who the calendar belongs to. Either pin the id, or give the email and the
# server resolves it at startup via the admin API. Run `npm run whoami` to list.
CALENDAR_USER_EMAIL=daniel20000xd@gmail.com
# CALENDAR_USER_ID=

# IANA timezone used to (a) render the read_calendar digest and (b) nothing else
# — add_event still requires explicit offsets on every timestamp.
CALENDAR_TZ=Europe/Stockholm
